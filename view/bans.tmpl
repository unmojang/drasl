{{ template "layout" . }}

{{ define "title" }}{{ call .T "Bans" }}{{ end }}

{{ define "ban-actions" }}
  <button type="button" onclick="document.getElementById('edit-{{ .Ban.ID }}').showModal()">{{ call .T "Edit" }}</button>
  <form class="inline-form" action="{{ .App.FrontEndURL }}/web/admin/bans/delete" method="post" onsubmit="return confirm('{{ call .T "Remove this ban?" }}');">
    <input hidden name="banId" value="{{ .Ban.ID }}" />
    <input hidden name="returnUrl" value="{{ .App.FrontEndURL }}/web/admin/bans" />
    <input type="submit" value="{{ call .T "Unban" }}" />
  </form>
{{ end }}

{{ define "edit-ban-dialog" }}
  <dialog id="edit-{{ .Ban.ID }}">
    <form action="{{ .App.FrontEndURL }}/web/admin/bans/update" method="post">
      <h3>{{ call .T "Edit ban" }}</h3>
      <p><strong>{{ .DisplayTarget }}</strong></p>
      {{ if or (eq .Ban.Type "USER") (eq .Ban.Type "PLAYER") }}
        <p>
          <label>{{ call .T "Reason message" }}<br />
            <textarea name="reasonMessage" maxlength="512">{{ if .Ban.ReasonMessage.Valid }}{{ .Ban.ReasonMessage.String }}{{ end }}</textarea>
          </label>
        </p>
        <p>
          <label>{{ call .T "Duration" }}<br />
            <select name="duration" class="ban-duration">
              <option value="keep">{{ call .T "Keep current expiration" }}</option>
              {{ template "ban-duration-options" . }}
            </select>
          </label><br />
          <input class="ban-duration-custom" type="datetime-local" name="durationCustom" hidden />
        </p>
      {{ end }}
      <input hidden name="banId" value="{{ .Ban.ID }}" />
      <input hidden name="returnUrl" value="{{ .App.FrontEndURL }}/web/admin/bans" />
      <p class="dialog-actions">
        <button type="button" onclick="this.closest('dialog').close()">{{ call .T "Cancel" }}</button>
        <input type="submit" value="{{ call .T "Save changes" }}" />
      </p>
    </form>
  </dialog>
{{ end }}

{{ define "content" }}
  {{ template "header" . }}

  {{ template "admin-nav" . }}

  <div class="section-heading">
    <h1>{{ call .T "Bans" }}</h1>
    <button type="button" onclick="openBanDialog()">+ {{ call .T "Create ban" }}</button>
  </div>

  {{ template "ban-create-dialog" . }}

  <h3>{{ call .T "Users and players" }}</h3>
  {{ if .IdentityBans }}
    <table>
      <thead><tr><td>{{ call .T "Type" }}</td><td>{{ call .T "Target" }}</td><td>{{ call .T "Reason" }}</td><td>{{ call .T "Expires" }}</td><td></td></tr></thead>
      <tbody>
        {{ range $item := .IdentityBans }}
          <tr>
            <td>{{ if eq $item.Ban.Type "USER" }}{{ call $.T "User" }}{{ else }}{{ call $.T "Player" }}{{ end }}</td>
            <td>{{ if $item.TargetURL }}<a href="{{ $item.TargetURL }}">{{ $item.DisplayTarget }}</a>{{ else }}{{ $item.DisplayTarget }}{{ end }}</td>
            <td>{{ call $.T $item.ReasonLabel }}{{ if $item.Ban.ReasonMessage.Valid }}<br /><small>{{ $item.Ban.ReasonMessage.String }}</small>{{ end }}</td>
            <td>{{ if $item.Ban.ExpiresAt.Valid }}{{ $item.Ban.ExpiresAt.Time.Format "2006-01-02 15:04 MST" }}{{ else }}{{ call $.T "Permanent" }}{{ end }}</td>
            <td>{{ template "ban-actions" $item }}</td>
          </tr>
        {{ end }}
      </tbody>
    </table>
    {{ range $item := .IdentityBans }}{{ template "edit-ban-dialog" $item }}{{ end }}
  {{ else }}<p>{{ call .T "No user or player bans." }}</p>{{ end }}

  <h3>{{ call .T "Skins" }}</h3>
  {{ if .SkinBans }}
    <table>
      <thead><tr><td>{{ call .T "SHA-256" }}</td><td></td></tr></thead>
      <tbody>{{ range $item := .SkinBans }}<tr><td class="break-word">{{ $item.Ban.Target }}</td><td>{{ template "ban-actions" $item }}</td></tr>{{ end }}</tbody>
    </table>
    {{ range $item := .SkinBans }}{{ template "edit-ban-dialog" $item }}{{ end }}
  {{ else }}<p>{{ call .T "No skin bans." }}</p>{{ end }}

  <h3>{{ call .T "Capes" }}</h3>
  {{ if .CapeBans }}
    <table>
      <thead><tr><td>{{ call .T "SHA-256" }}</td><td></td></tr></thead>
      <tbody>{{ range $item := .CapeBans }}<tr><td class="break-word">{{ $item.Ban.Target }}</td><td>{{ template "ban-actions" $item }}</td></tr>{{ end }}</tbody>
    </table>
    {{ range $item := .CapeBans }}{{ template "edit-ban-dialog" $item }}{{ end }}
  {{ else }}<p>{{ call .T "No cape bans." }}</p>{{ end }}

  <h3>{{ call .T "Names" }}</h3>
  {{ if .NameBans }}
    <table>
      <thead><tr><td>{{ call .T "Name" }}</td><td></td></tr></thead>
      <tbody>{{ range $item := .NameBans }}<tr><td>{{ $item.Ban.Target }}</td><td>{{ template "ban-actions" $item }}</td></tr>{{ end }}</tbody>
    </table>
    {{ range $item := .NameBans }}{{ template "edit-ban-dialog" $item }}{{ end }}
  {{ else }}<p>{{ call .T "No name bans." }}</p>{{ end }}

  <script>
    for (const form of document.querySelectorAll("dialog[id^='edit-'] form")) {
      initializeBanForm(form);
    }
  </script>

  {{ template "footer" . }}
{{ end }}
