{{ define "ban-duration-options" }}
  <option value="1h">{{ call .T "1 hour" }}</option>
  <option value="6h">{{ call .T "6 hours" }}</option>
  <option value="1d">{{ call .T "1 day" }}</option>
  <option value="3d">{{ call .T "3 days" }}</option>
  <option value="1w">{{ call .T "1 week" }}</option>
  <option value="2w">{{ call .T "2 weeks" }}</option>
  <option value="1mo">{{ call .T "1 month" }}</option>
  <option value="3mo">{{ call .T "3 months" }}</option>
  <option value="6mo">{{ call .T "6 months" }}</option>
  <option value="1y">{{ call .T "1 year" }}</option>
  <option value="custom">{{ call .T "Custom date" }}</option>
  <option value="permanent">{{ call .T "Permanent" }}</option>
{{ end }}

{{ define "ban-reason-fields" }}
  <p>
    <label>{{ call .T "Reason" }}<br />
      <select name="reasonChoice" id="{{ if .Report }}report-ban-reason{{ else }}ban-reason{{ end }}">
        {{ range $reason := .MojangReasons }}
          <option value="{{ $reason.ID }}">{{ call $.T $reason.Label }}</option>
        {{ end }}
        <option value="custom">{{ call .T "Custom…" }}</option>
      </select>
    </label>
  </p>
  <p id="{{ if .Report }}report-custom-reason{{ else }}custom-reason-id{{ end }}" hidden>
    <label>{{ call .T "Custom reason ID (optional)" }}<br />
      <input type="number" name="customReasonId" min="60" {{ if not .Report }}placeholder="{{ call .T "Generated automatically" }}"{{ end }} />
    </label>
  </p>
  <p>
    <label>{{ call .T "Reason message" }}<br />
      <textarea name="reasonMessage" id="{{ if .Report }}report-reason-message{{ else }}ban-reason-message{{ end }}" maxlength="512"></textarea>
    </label><br />
    <small>{{ call .T "Optional for Mojang reasons; required for a custom reason." }}</small>
  </p>
  <p>
    <label>{{ call .T "Duration" }}<br />
      <select name="duration" {{ if not .Report }}id="ban-duration"{{ end }} class="ban-duration">
        {{ template "ban-duration-options" . }}
      </select>
    </label><br />
    <input class="ban-duration-custom" type="datetime-local" name="durationCustom" hidden />
  </p>
{{ end }}

{{ define "ban-form-script" }}
  <script>
    function initializeBanForm(form) {
      const update = () => {
        const reason = form.elements.reasonChoice;
        if (reason) {
          const custom = reason.value === "custom";
          form.elements.customReasonId.closest("p").hidden = !custom;
          form.elements.reasonMessage.required = custom;
        }
        for (const duration of form.querySelectorAll(".ban-duration")) {
          const custom = duration.closest("p").querySelector(".ban-duration-custom");
          custom.hidden = duration.value !== "custom";
          custom.required = duration.value === "custom";
        }
      };
      form.addEventListener("change", update);
      update();
      return update;
    }
  </script>
{{ end }}

{{ define "ban-create-dialog" }}
  <dialog id="create-ban-dialog">
    <form action="{{ .App.FrontEndURL }}/web/admin/bans/create" method="post" id="create-ban-form">
      <h3>{{ call .T "Create ban" }}</h3>
      <p id="ban-category-field">
        <label>{{ call .T "Category" }}<br />
          <select name="category" id="ban-category">
            <option value="IDENTITY">{{ call .T "User or player" }}</option>
            <option value="SKIN">{{ call .T "Skin" }}</option>
            <option value="CAPE">{{ call .T "Cape" }}</option>
            <option value="NAME">{{ call .T "Name" }}</option>
          </select>
        </label>
      </p>
      <p id="ban-target-field">
        <label>{{ call .T "Target" }}<br />
          <input type="text" class="long" required name="target" id="ban-target" />
        </label><br />
        <small id="ban-target-help"></small>
      </p>

      <div id="identity-fields">
        {{ template "ban-reason-fields" (BanReasonFields .T false) }}
      </div>

      <input hidden name="returnUrl" value="{{ .URL }}" />
      <p class="dialog-actions">
        <button type="button" onclick="this.closest('dialog').close()">{{ call .T "Cancel" }}</button>
        <input type="submit" value="{{ call .T "Create ban" }}" />
      </p>
    </form>
  </dialog>

  {{ template "ban-form-script" . }}
  <script>
    const banDialog = document.getElementById("create-ban-dialog");
    const banForm = document.getElementById("create-ban-form");
    const banCategory = document.getElementById("ban-category");
    const banCategoryField = document.getElementById("ban-category-field");
    const banTarget = document.getElementById("ban-target");
    const banTargetHelp = document.getElementById("ban-target-help");
    const banIdentityFields = document.getElementById("identity-fields");

    function updateBanCategory() {
      banIdentityFields.hidden = banCategory.value !== "IDENTITY";
      banTargetHelp.textContent = banCategory.value === "IDENTITY"
        ? "{{ call .T "Enter a local user or player UUID." }}"
        : banCategory.value === "SKIN"
          ? "{{ call .T "Enter the skin SHA-256 hash." }}"
          : banCategory.value === "CAPE"
            ? "{{ call .T "Enter the cape SHA-256 hash." }}"
            : "{{ call .T "Enter the player name to ban." }}";
    }

    function openBanDialog(categoryValue, targetValue) {
      banForm.reset();
      const contextual = Boolean(categoryValue);
      banCategoryField.hidden = contextual;
      banTarget.readOnly = contextual;
      banTargetHelp.hidden = contextual;
      if (contextual) {
        banCategory.value = categoryValue;
        banTarget.value = targetValue;
      }
      updateBanCategory();
      refreshBanForm();
      banDialog.showModal();
    }

    function openBanDialogFromButton(button) {
      openBanDialog(
        button.dataset.banCategory,
        button.dataset.banTarget,
      );
    }

    banCategory.addEventListener("change", updateBanCategory);
    updateBanCategory();
    const refreshBanForm = initializeBanForm(banForm);
  </script>
{{ end }}
