{{ template "layout" . }}

{{ define "title" }}{{ .Player.Name }}{{ end }}

{{ define "head" }}
  <link rel="stylesheet" href="{{ .App.PublicURL }}/skin-viewer.css" />
{{ end }}

{{ define "cssSkinFaces" }}
  <div class="s-left"></div>
  <div class="s-right"></div>
  <div class="s-top"></div>
  <div class="s-bottom"></div>
  <div class="s-front"></div>
  <div class="s-back"></div>
{{ end }}

{{ define "content" }}

  {{ template "header" . }}

  <p>
    {{ if .AdminView }}
      <a href="{{ .App.FrontEndURL }}/web/user/{{ .PlayerUser.UUID }}">{{ call .T "Back to %s's account" .PlayerUser.Username }}</a>
    {{ else }}
      <a href="{{ .App.FrontEndURL }}/web/user">{{ call .T "Back to your account" }}</a>
    {{ end }}
  </p>

  <h1 style="text-align: center;">{{ .Player.Name }}</h1>
  <h6 style="text-align: center;">{{ .Player.UUID }}<br />{{ .PlayerID }}</h6>
  <div id="skin-container" style="min-height: 300px;">
    {{/* Shown when the skinview3d viewer isn't running: by this style with
      scripting off, and by the viewer itself if it fails to start.
    */}}
    <noscript
      ><style>
        .css-skin-scene {
          display: block;
        }
        .css-skin-controls {
          display: flex;
        }
      </style></noscript
    >
    <div
      id="css-skin-scene"
      class="css-skin-scene"
      style="--texture: url({{ .Preview.SkinURL }});{{ with $capeURL := .Preview.CapeURL }}
        --cape: url({{ $capeURL }});
      {{ end }}"
    >
      <div
        class="css-skin{{ if eq .Preview.Model "slim" }}
          css-skin-slim
        {{ end }}"
        role="img"
        aria-label="{{ call .T "%s's Model" .Player.Name }}"
      >
        <div class="css-skin-part css-skin-head">
          {{ template "cssSkinFaces" }}
        </div>
        <div class="css-skin-part css-skin-head css-skin-hat css-skin-layer2">
          {{ template "cssSkinFaces" }}
        </div>
        <div class="css-skin-part css-skin-body">
          {{ template "cssSkinFaces" }}
        </div>
        <div
          class="css-skin-part css-skin-body css-skin-jacket css-skin-layer2"
        >
          {{ template "cssSkinFaces" }}
        </div>
        <div
          class="css-skin-pivot css-skin-swing css-skin-arm css-skin-arm-right"
        >
          <div class="css-skin-part css-skin-limb">
            {{ template "cssSkinFaces" }}
          </div>
          <div class="css-skin-part css-skin-limb css-skin-layer2">
            {{ template "cssSkinFaces" }}
          </div>
        </div>
        <div
          class="css-skin-pivot css-skin-swing css-skin-arm css-skin-arm-left"
        >
          <div class="css-skin-part css-skin-limb css-skin-mirrored">
            {{ template "cssSkinFaces" }}
          </div>
          <div class="css-skin-part css-skin-limb css-skin-layer2">
            {{ template "cssSkinFaces" }}
          </div>
        </div>
        <div class="css-skin-pivot css-skin-swing css-skin-leg-right">
          <div class="css-skin-part css-skin-limb">
            {{ template "cssSkinFaces" }}
          </div>
          <div class="css-skin-part css-skin-limb css-skin-layer2">
            {{ template "cssSkinFaces" }}
          </div>
        </div>
        <div class="css-skin-pivot css-skin-swing css-skin-leg-left">
          <div class="css-skin-part css-skin-limb css-skin-mirrored">
            {{ template "cssSkinFaces" }}
          </div>
          <div class="css-skin-part css-skin-limb css-skin-layer2">
            {{ template "cssSkinFaces" }}
          </div>
        </div>
        {{ if .Preview.CapeURL }}
          <div class="css-skin-pivot css-skin-cape-pivot">
            <div class="css-skin-part css-skin-cape">
              {{ template "cssSkinFaces" }}
            </div>
          </div>
          <div
            class="css-skin-pivot css-skin-elytra-pivot css-skin-elytra-left"
          >
            <div class="css-skin-part css-skin-wing">
              {{ template "cssSkinFaces" }}
            </div>
          </div>
          <div
            class="css-skin-pivot css-skin-elytra-pivot css-skin-elytra-right"
          >
            <div class="css-skin-part css-skin-wing">
              {{ template "cssSkinFaces" }}
            </div>
          </div>
        {{ end }}
      </div>
    </div>
    <div class="skin-controls css-skin-controls">
      <label class="skin-control">
        <input
          type="checkbox"
          class="css-skin-play visually-hidden"
          autocomplete="off"
        />
        <span
          class="skin-icon skin-icon-play css-skin-control-play"
          aria-hidden="true"
        ></span>
        <span
          class="skin-icon skin-icon-pause css-skin-control-pause"
          aria-hidden="true"
        ></span>
        <span class="visually-hidden css-skin-control-play"
          >{{ call .T "Play animation" }}</span
        >
        <span class="visually-hidden css-skin-control-pause"
          >{{ call .T "Pause animation" }}</span
        >
      </label>
      <label class="skin-control">
        <input
          type="checkbox"
          class="css-skin-back visually-hidden"
          autocomplete="off"
        />
        {{/* One icon mirrored, so the two directions can't disagree. */}}
        <span
          class="skin-icon skin-icon-rotate css-skin-control-show-back css-skin-control-mirrored"
          aria-hidden="true"
        ></span>
        <span
          class="skin-icon skin-icon-rotate css-skin-control-show-front"
          aria-hidden="true"
        ></span>
        <span class="visually-hidden css-skin-control-show-back"
          >{{ call .T "Show the back" }}</span
        >
        <span class="visually-hidden css-skin-control-show-front"
          >{{ call .T "Show the front" }}</span
        >
      </label>
      {{ if .Preview.CapeURL }}
        <label class="skin-control">
          <input
            type="checkbox"
            class="css-skin-elytra visually-hidden"
            autocomplete="off"
          />
          <span class="css-skin-control-show-elytra" aria-hidden="true"
            >🪽</span
          >
          <span class="css-skin-control-show-cape" aria-hidden="true">🦸</span>
          <span class="visually-hidden css-skin-control-show-elytra"
            >{{ call .T "Show elytra" }}</span
          >
          <span class="visually-hidden css-skin-control-show-cape"
            >{{ call .T "Show cape" }}</span
          >
        </label>
      {{ end }}
    </div>
    <canvas id="skin-canvas" hidden></canvas>
  </div>
  <form
    action="{{ .App.FrontEndURL }}/web/update-player"
    method="post"
    enctype="multipart/form-data"
  >
    {{ if or .App.Config.AllowChangingPlayerName .User.IsAdmin }}
      <p>
        <label for="player-name">{{ if .AdminView }}{{call .T
          "Player name (can be different from %s's %s username)"
          .PlayerUser.Username
          .App.Config.ApplicationName
        }}{{ else }}{{ call .T
          "Player name (can be different from your %s username)"
          .App.Config.ApplicationName
        }}{{ end }}</label>
        <br />
        <input
          type="text"
          name="playerName"
          id="player-name"
          value="{{ .Player.Name }}"
        />
      </p>
    {{ end }}
    {{ if or .App.Config.AllowSkins .User.IsAdmin }}
      <h4>{{ call .T "Skin" }}</h4>
      {{ if .SkinURL }}
        <p>
          <span style="vertical-align: top">{{ call .T "Current skin:" }}</span>
          <img class="small-texture-preview" src="{{ .SkinURL }}">
        </p>
      {{ end }}
      <p>
        <label for="skin-file">{{ call .T "Upload a skin" }}</label><br />
        <input type="file" name="skinFile" id="skin-file" />
      </p>
      {{ if or .App.Config.AllowTextureFromURL .User.IsAdmin }}
        <p>
          <label for="skin-url">{{ call .T "or instead, provide a URL to a skin" }}</label><br />
          <input
            type="text"
            name="skinUrl"
            id="skin-url"
            class="long"
            placeholder="{{ call .T "Leave blank to keep" }}"
          />
        </p>
      {{ end }}
      <p>
        <label for="delete-skin">{{ call .T
          "or instead, check the box to delete the current skin"
        }}</label>
        <input type="checkbox" name="deleteSkin" id="delete-skin" />
      </p>
      <fieldset>
        <legend>{{ call .T "Skin model" }}</legend>
        <input
          type="radio"
          id="skin-model-classic"
          name="skinModel"
          value="classic"
          {{ if eq .Player.SkinModel "classic" }}checked{{ end }}
        />
        <label for="skin-model-classic">{{ call .T "Classic" }}</label>
        <input
          type="radio"
          id="skin-model-slim"
          name="skinModel"
          value="slim"
          {{ if eq .Player.SkinModel "slim" }}checked{{ end }}
        />
        <label for="skin-model-slim">{{ call .T "Slim" }}</label>
      </fieldset>
    {{ end }}
    {{ if or .App.Config.AllowCapes .User.IsAdmin }}
      <h4>{{ call .T "Cape" }}</h4>
      {{ if .CapeURL }}
        <p>
          <span style="vertical-align: top">{{ call .T "Current cape:" }}</span>
          <img class="small-texture-preview" src="{{ .CapeURL }}">
        </p>
      {{ end }}
      <p>
        <label for="cape-file">{{ call .T "Upload a cape" }}</label><br />
        <input type="file" name="capeFile" id="cape-file" />
      </p>
      {{ if or .App.Config.AllowTextureFromURL .User.IsAdmin }}
        <p>
          <label for="cape-url">{{ call .T "or instead, provide a URL to a cape" }}</label><br />
          <input
            type="text"
            name="capeUrl"
            id="cape-url"
            class="long"
            placeholder="{{ call .T "Leave blank to keep" }}"
          />
        </p>
      {{ end }}
      <p>
        <label for="delete-cape">{{ call .T
          "or instead, check the box to delete the current cape"
        }}</label>
        <input type="checkbox" name="deleteCape" id="delete-cape" />
      </p>
    {{ end }}
    {{ if .App.Config.ForwardSkins }}
      <p>
        <label for="fallback-player">{{ call .T "Fallback Player" }}</label>
        <br>
        <small>{{ call .T "UUID or player name. If you don't set a skin or cape, this player's skin on one of the fallback API servers will be used instead." }}</small>
        <br>
        <input
          class="long"
          type="text"
          name="fallbackPlayer"
          id="fallback-player"
          placeholder="{{ .Player.Name }}"
          value="{{ .Player.FallbackPlayer }}"
        />
      </p>
    {{ end }}
    <input hidden name="uuid" value="{{ .Player.UUID }}" />
    <input hidden name="returnUrl" value="{{ .URL }}" />
    <p style="text-align: center;">
      <input type="submit" value="{{ call .T "Save changes" }}" />
    </p>
  </form>
  {{ if or .App.Config.AllowAddingDeletingPlayers .User.IsAdmin }}
    <p>
      <details>
        <summary>{{ call .T "Delete Player" }}</summary>
        <form
          action="{{ .App.FrontEndURL }}/web/delete-player"
          method="post"
          onsubmit="return confirm('{{ call .T "Are you sure you want to delete the player “%s”? This action is irreversible." .Player.Name }}');"
        >
          <input hidden name="uuid" value="{{ .Player.UUID }}" />
          <input
            hidden
            name="returnUrl"
            value="{{ if .AdminView }}
              {{ .App.FrontEndURL }}/web/user/{{ .PlayerUser.UUID }}
            {{ else }}
              {{ .App.FrontEndURL }}/web/user
            {{ end }}"
          />
          <input type="submit" value="{{ call .T "Delete Player" }}" />
        </form>
      </details>
    </p>
  {{ end }}

  <script type="module">
    try {
      const { skinViewer } = await import("{{.App.PublicURL}}/bundle.js");
      skinViewer({
        canvas: document.getElementById("skin-canvas"),
        skinURL: {{ .Preview.SkinURL }},
        capeURL: {{ with $capeURL := .Preview.CapeURL }}{{ $capeURL }}{{ else }}null{{ end }},
        model: {{ .Preview.Model }},
        labels: {
          play: {{ call .T "Play animation" }},
          pause: {{ call .T "Pause animation" }},
          showElytra: {{ call .T "Show elytra" }},
          showCape: {{ call .T "Show cape" }},
        },
      });
    } catch (e) {
      // The bundle never loaded, so it can't reveal the CSS model itself.
      for (const el of document.querySelectorAll(".css-skin-scene, .css-skin-controls")) {
        el.classList.add("css-skin-shown");
      }
      throw e;
    }
  </script>

  {{ template "footer" . }}

{{ end }}
