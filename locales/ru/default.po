msgid "Can't link an OIDC account for another user unless you're an admin."
msgstr "Нельзя привязать OIDC аккаунт к другому пользователю без админ прав."

#: user.go:745 view/user.tmpl:221
msgid "Can't remove the last linked OIDC account."
msgstr "Нельзя удалить последний привязанный OIDC аккаунт."

#: player.go:140
msgid "Can't simultaneously import an existing player and choose a UUID."
msgstr ""
"Невозможно одновременно импортировать существующего игрока и выбрать UUID."

#: player.go:45
msgid "Can't specify both a file and a URL for %s texture."
msgstr "Невозможно указать одновременно файл и URL для текстуры %s."

